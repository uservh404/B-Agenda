# Copy to .env.calendar-authz.local. Never commit the local copy.
AUTHZ_TEST_SUPABASE_URL=https://YOUR_TEST_PROJECT_REF.supabase.co
AUTHZ_TEST_PROJECT_REF=YOUR_TEST_PROJECT_REF
AUTHZ_TEST_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
AUTHZ_TEST_EMPLOYEE_EMAIL=employee-test@example.invalid
AUTHZ_TEST_EMPLOYEE_PASSWORD=SET_LOCALLY_ONLY
AUTHZ_TEST_EMPLOYEE_ID=REPLACE_WITH_REAL_EMPLOYEE_UUID
AUTHZ_TEST_PARTICIPANT_ID=REPLACE_WITH_REAL_PARTICIPANT_UUID
AUTHZ_TEST_CONFIRM_NON_PRODUCTION=I_CONFIRM_THIS_IS_A_NON_PRODUCTION_TEST_PROJECT
